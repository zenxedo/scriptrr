# Version control / editor noise
.git
.gitignore
.github
.idea
.vscode
*.md

# Runtime data — never bake into the image
logs/
*.db
*.sqlite
*.sqlite3
metadata.json
schedule_metadata.json

# User scripts (mounted as a volume at runtime)
scripts/*
!scripts/.gitkeep

# Secrets
.env
.env.*
*.env
*.key
*.pem
*secret*

# Build / Python caches
__pycache__/
*.pyc
*.pyo
.venv/
venv/
